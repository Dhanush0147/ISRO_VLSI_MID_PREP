###################################################################

# Created by write_sdc on Sun Dec  7 18:23:15 2025

###################################################################
set sdc_version 2.2

set_units -time ns -resistance kOhm -capacitance pF -voltage V -current uA
set_operating_conditions -max tsl18fs120_scl_ss -max_library tsl18fs120_scl_ss\
                         -min tsl18fs120_scl_ff -min_library tsl18fs120_scl_ff
create_clock [get_ports clk]  -period 1000  -waveform {0 500}
set_clock_uncertainty 20  [get_clocks clk]
set_input_delay -clock clk  100  [get_ports adc_lvds_pin]
set_input_delay -clock clk  100  [get_ports {addr_hf[5]}]
set_input_delay -clock clk  100  [get_ports {addr_hf[4]}]
set_input_delay -clock clk  100  [get_ports {addr_hf[3]}]
set_input_delay -clock clk  100  [get_ports {addr_hf[2]}]
set_input_delay -clock clk  100  [get_ports {addr_hf[1]}]
set_input_delay -clock clk  100  [get_ports {addr_hf[0]}]
set_input_delay -clock clk  100  [get_ports rst]
set_output_delay -clock clk  100  [get_ports {adc_output[19]}]
set_output_delay -clock clk  100  [get_ports {adc_output[18]}]
set_output_delay -clock clk  100  [get_ports {adc_output[17]}]
set_output_delay -clock clk  100  [get_ports {adc_output[16]}]
set_output_delay -clock clk  100  [get_ports {adc_output[15]}]
set_output_delay -clock clk  100  [get_ports {adc_output[14]}]
set_output_delay -clock clk  100  [get_ports {adc_output[13]}]
set_output_delay -clock clk  100  [get_ports {adc_output[12]}]
set_output_delay -clock clk  100  [get_ports {adc_output[11]}]
set_output_delay -clock clk  100  [get_ports {adc_output[10]}]
set_output_delay -clock clk  100  [get_ports {adc_output[9]}]
set_output_delay -clock clk  100  [get_ports {adc_output[8]}]
set_output_delay -clock clk  100  [get_ports {adc_output[7]}]
set_output_delay -clock clk  100  [get_ports {adc_output[6]}]
set_output_delay -clock clk  100  [get_ports {adc_output[5]}]
set_output_delay -clock clk  100  [get_ports {adc_output[4]}]
set_output_delay -clock clk  100  [get_ports {adc_output[3]}]
set_output_delay -clock clk  100  [get_ports {adc_output[2]}]
set_output_delay -clock clk  100  [get_ports {adc_output[1]}]
set_output_delay -clock clk  100  [get_ports {adc_output[0]}]
set_output_delay -clock clk  100  [get_ports {HF_out[23]}]
set_output_delay -clock clk  100  [get_ports {HF_out[22]}]
set_output_delay -clock clk  100  [get_ports {HF_out[21]}]
set_output_delay -clock clk  100  [get_ports {HF_out[20]}]
set_output_delay -clock clk  100  [get_ports {HF_out[19]}]
set_output_delay -clock clk  100  [get_ports {HF_out[18]}]
set_output_delay -clock clk  100  [get_ports {HF_out[17]}]
set_output_delay -clock clk  100  [get_ports {HF_out[16]}]
set_output_delay -clock clk  100  [get_ports {HF_out[15]}]
set_output_delay -clock clk  100  [get_ports {HF_out[14]}]
set_output_delay -clock clk  100  [get_ports {HF_out[13]}]
set_output_delay -clock clk  100  [get_ports {HF_out[12]}]
set_output_delay -clock clk  100  [get_ports {HF_out[11]}]
