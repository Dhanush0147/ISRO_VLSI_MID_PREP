set_output_delay -clock clk  100  [get_ports {HF_out[4]}]
set_output_delay -clock clk  100  [get_ports {HF_out[3]}]
set_output_delay -clock clk  100  [get_ports {HF_out[2]}]
set_output_delay -clock clk  100  [get_ports {HF_out[1]}]
set_output_delay -clock clk  100  [get_ports {HF_out[0]}]
set_output_delay -clock clk  100  [get_ports adc_valid]
set_output_delay -clock clk  100  [get_ports adc_fb_pin]
set_false_path   -from [get_ports rst]
